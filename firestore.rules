rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.email in ['ekotb555@gmail.com']; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isAdmin() { return isSuper() || (hasProfile() && me().role in ['admin', 'support']); }
    function isTopAdmin() { return isSuper() || (hasProfile() && me().role == 'admin'); }
    // Support may manage everyone except Modaqqeq admins.
    function notAdminUser(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role != 'admin'; }
    function inShop(shopId) { return hasProfile() && shopId in me().shopIds; }
    function staffOf(shopId) {
      return isAdmin() || (inShop(shopId) && me().role in ['reviewer', 'accountant', 'manager', 'owner']);
    }
    function reviewerOf(shopId) {
      return isAdmin() || (inShop(shopId) && me().role in ['reviewer', 'accountant']);
    }
    function shiftData(shiftId) { return get(/databases/$(database)/documents/shifts/$(shiftId)).data; }

    // Shop name, logo and cashier list — only that shop's people and Modaqqeq admins can see it.
    match /shopsPublic/{shopId} {
      allow read: if isAdmin() || inShop(shopId);
      allow write: if isAdmin();
      // A cashier may change only his own photo.
      allow update: if inShop(shopId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos'])
        && request.resource.data.get('photos', {}).diff(resource.data.get('photos', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /shops/{shopId} {
      allow read: if isAdmin() || inShop(shopId);
      allow create, delete: if isAdmin();
      // التعديل هنا: السماح للكاشير بإضافة أسماء للقوائم (موظفين، موردين، مصروفات، إيرادات)
      allow update: if isAdmin()
        || (inShop(shopId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'openShift', 'lastHandover', 'openShifts', 'lastHandovers', 
            'staff', 'shopExpenses', 'suppliers', 'incomeReasons'
        ]));
    }

    // Cashier PINs so Modaqqeq admins can change them later (free plan has no server).
    match /cashierSecrets/{uid} {
      allow read: if isTopAdmin() || (isAdmin() && notAdminUser(uid));
      allow write: if isTopAdmin() || (isAdmin() && notAdminUser(uid)) || (signedIn() && request.auth.uid == uid);
    }

    // Numbers typed on the computer, waiting for the photos from the phone. Only the owner sees them.
    match /drafts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isTopAdmin()
        || (isAdmin() && request.resource.data.role != 'admin' && (resource == null || resource.data.role != 'admin'));
      allow delete: if isTopAdmin();
      // Anyone may change only his own app colours, picture and notification choices.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'photo', 'notifyPrefs']);
    }

    match /shifts/{shiftId} {
      allow read: if staffOf(resource.data.shopId) || (signedIn() && resource.data.cashierUid == request.auth.uid);
      allow create: if inShop(request.resource.data.shopId)
        && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if reviewerOf(resource.data.shopId)
        || (signedIn() && resource.data.cashierUid == request.auth.uid && resource.data.status == 'open'
            && request.resource.data.cashierUid == request.auth.uid
            && request.resource.data.status in ['open', 'submitted'])
        // Shift reopened by the accountant: the cashier finishes editing and sends it back.
        || (signedIn() && resource.data.cashierUid == request.auth.uid && resource.data.status == 'reopened'
            && request.resource.data.status in ['reopened', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenPending', 'cashierAttention', 'cashierUnread', 'staffUnread', 'lastMsg', 'reopenDoneAt', 'entryCount']))
        // التعديل هنا: السماح للكاشير بإرسال طلب إضافة مصروف أو الإقرار بالعجز بعد إغلاق الوردية
        || (signedIn() && resource.data.cashierUid == request.auth.uid && resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shortageAck', 'shortageAckAt', 'shortageState', 'cashierRequests', 'status', 'staffUnread', 'cashierAttention', 'reopenPending', 'lastMsg']))
        // Chat flags, any time.
        || ((staffOf(resource.data.shopId) || (signedIn() && resource.data.cashierUid == request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cashierAttention', 'cashierUnread', 'staffUnread', 'lastMsg']));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if staffOf(shiftData(shiftId).shopId) || shiftData(shiftId).cashierUid == request.auth.uid;
        allow create: if signedIn() && request.resource.data.byUid == request.auth.uid
          && (staffOf(shiftData(shiftId).shopId) || shiftData(shiftId).cashierUid == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      match /entries/{entryId} {
        allow read: if staffOf(shiftData(shiftId).shopId) || shiftData(shiftId).cashierUid == request.auth.uid;
        allow create: if reviewerOf(shiftData(shiftId).shopId)
          || (signedIn() && shiftData(shiftId).cashierUid == request.auth.uid && shiftData(shiftId).status in ['open', 'reopened']);
        allow update: if reviewerOf(shiftData(shiftId).shopId)
          || (signedIn() && shiftData(shiftId).cashierUid == request.auth.uid && shiftData(shiftId).status in ['open', 'reopened']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedAtLocal', 'deletedBy', 'deletedByName', 'deleteReason']));
        allow delete: if reviewerOf(shiftData(shiftId).shopId);
      }

      match /photos/{photoId} {
        allow read: if staffOf(shiftData(shiftId).shopId) || shiftData(shiftId).cashierUid == request.auth.uid;
        allow create: if signedIn() && shiftData(shiftId).cashierUid == request.auth.uid;
        allow update, delete: if reviewerOf(shiftData(shiftId).shopId);
      }
    }

    // Sales numbers live here so the cashier never sees them.
    match /reviews/{shiftId} {
      allow read: if signedIn() && (resource == null || staffOf(resource.data.shopId));
      allow create: if reviewerOf(request.resource.data.shopId);
      allow update: if reviewerOf(resource.data.shopId);
      allow delete: if isAdmin();
    }

    // Money between two registers of the same shop (float, sub cashier handing over). Receiver confirms.
    match /transfers/{id} {
      allow read: if isAdmin() || inShop(resource.data.shopId);
      allow create: if inShop(request.resource.data.shopId)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if reviewerOf(resource.data.shopId)
        || (inShop(resource.data.shopId) && resource.data.status == 'pending'
            && ((request.resource.data.status == 'accepted' && request.resource.data.toUid == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'toUid', 'toName', 'toShiftId', 'acceptedAmount', 'acceptedDiff', 'acceptedAt']))
              || (request.resource.data.status == 'cancelled' && resource.data.fromUid == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))));
      allow delete: if isAdmin();
    }

    // Shortages (عجز) and overages (زيادة) per cashier.
    match /ledger/{id} {
      allow read: if staffOf(resource.data.shopId) || (signedIn() && resource.data.cashierUid == request.auth.uid);
      allow create: if reviewerOf(request.resource.data.shopId);
      // التعديل هنا: السماح للكاشير بالإقرار بالعجز في السجل
      allow update: if reviewerOf(resource.data.shopId)
        || (signedIn() && resource.data.cashierUid == request.auth.uid 
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt']));
      allow delete: if isAdmin();
    }

    // ── Free Apps Script helper (it works with the project owner's own access, rules don't apply to it) ──
    // A request for a notification. Only from someone in that shop; nobody reads it but the script.
    match /outbox/{id} {
      allow create: if signedIn() && request.resource.data.byUid == request.auth.uid
        && (isAdmin() || inShop(request.resource.data.shopId))
        && request.resource.data.keys().hasOnly(['type', 'shopId', 'shiftId', 'to', 'toUid', 'title', 'body', 'byUid', 'atMs'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 240;
      allow read, update, delete: if false;
    }
    // A ticket asking the script to move one photo to Google Drive.
    match /photoQueue/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['path', 'uid', 'atMs'])
        && request.resource.data.path is string && request.resource.data.path.size() < 200;
      allow read, update, delete: if false;
    }
    // This device's notification address. Each person sees and changes only his own.
    match /pushTokens/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['uid', 'token', 'device', 'atMs']);
    }

    // ── Bank SMS forwarded from the shop owner's phone (written only by the Apps Script helper) ──
    // Secret link per wallet. Only Modaqqeq admins and support make or see them.
    match /smsKeys/{key} {
      allow read, write: if isAdmin();
    }
    // What the shop owes each machine's rep («شحن آجل» adds, «سداد» takes off). The shop's people change it with their operations.
    match /repDebts/{shopId} {
      allow read: if inShop(shopId) || staffOf(shopId);
      allow create, update: if reviewerOf(shopId) || isAdmin()
        || (inShop(shopId) && request.resource.data.keys().hasOnly(['machines', 'atMs']));
      match /log/{id} {
        allow read: if inShop(shopId) || staffOf(shopId);
        allow create: if (inShop(shopId) || reviewerOf(shopId)) && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['machine', 'delta', 'shiftId', 'entryId', 'by', 'byName', 'note', 'atMs']);
        allow update, delete: if isAdmin();
      }
    }
    // Bank message formats taught from the app (used for every shop).
    match /smsFormats/{id} {
      allow read, write: if isAdmin();
    }
    // One incoming transfer. The shop's people see it; a cashier takes it ("my customer") or gives back his own.
    match /walletIn/{id} {
      allow read: if inShop(resource.data.shopId) || staffOf(resource.data.shopId);
      allow update: if reviewerOf(resource.data.shopId)
        || (inShop(resource.data.shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedByName', 'claimedShiftId', 'claimedEntryId', 'claimedAtMs'])
            && ((resource.data.status == 'new' && request.resource.data.status == 'claimed' && request.resource.data.claimedBy == request.auth.uid)
                || (resource.data.status == 'claimed' && resource.data.claimedBy == request.auth.uid && request.resource.data.status == 'new')));
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Login & activity log. Everyone writes only lines about himself; nobody edits or deletes.
    // Only Modaqqeq's owner and support can read it.
    match /activity/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'shopIds', 'action', 'text', 'shopId', 'shiftId', 'device', 'deviceLabel', 'deviceId', 'day', 'at', 'atLocal'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow read: if isSuper() || (hasProfile() && me().role == 'support');
      allow update, delete: if false;
    }
  }
}
